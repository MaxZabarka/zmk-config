if SHIELD_CORNE_TRACKPAD_LEFT

config ZMK_KEYBOARD_NAME
	default "Corne Trackpad"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

endif

if SHIELD_CORNE_TRACKPAD_RIGHT

config ZMK_KEYBOARD_NAME
	default "Corne Trackpad"

config ZMK_POINTING
	default y

config I2C
	default y

endif

if SHIELD_CORNE_TRACKPAD_LEFT || SHIELD_CORNE_TRACKPAD_RIGHT

config ZMK_SPLIT
	default y

endif